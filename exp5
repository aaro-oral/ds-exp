#include <stdio.h>
#define SIZE 5

int q[SIZE], front = -1, rear = -1;
int cq[SIZE], cf = -1, cr = -1;
int dq[SIZE], df = -1, dr = -1;

void enqueue() {
    int x;

    if (rear == SIZE - 1) {
        printf("Queue Overflow\n");
        return;
    }

    printf("Enter value: ");
    scanf("%d", &x);

    if (front == -1)
        front = 0;

    q[++rear] = x;
}

void dequeue() {
    if (front == -1 || front > rear) {
        printf("Queue Underflow\n");
        return;
    }

    printf("Deleted: %d\n", q[front++]);

    if (front > rear)
        front = rear = -1;
}

void display() {
    if (front == -1) {
        printf("Queue is empty\n");
        return;
    }

    for (int i = front; i <= rear; i++)
        printf("%d ", q[i]);

    printf("\n");
}

void circularEnqueue() {
    int x;

    if ((cr + 1) % SIZE == cf) {
        printf("Circular Queue Overflow\n");
        return;
    }

    printf("Enter value: ");
    scanf("%d", &x);

    if (cf == -1)
        cf = 0;

    cr = (cr + 1) % SIZE;
    cq[cr] = x;
}

void circularDequeue() {
    if (cf == -1) {
        printf("Circular Queue Underflow\n");
        return;
    }

    printf("Deleted: %d\n", cq[cf]);

    if (cf == cr)
        cf = cr = -1;
    else
        cf = (cf + 1) % SIZE;
}

void circularDisplay() {
    if (cf == -1) {
        printf("Circular Queue is empty\n");
        return;
    }

    int i = cf;

    while (1) {
        printf("%d ", cq[i]);

        if (i == cr)
            break;

        i = (i + 1) % SIZE;
    }

    printf("\n");
}

void dequeInsertFront() {
    int x;

    if ((df == 0 && dr == SIZE - 1) || df == dr + 1) {
        printf("Deque Overflow\n");
        return;
    }

    printf("Enter value: ");
    scanf("%d", &x);

    if (df == -1) {
        df = dr = 0;
    } else if (df == 0) {
        df = SIZE - 1;
    } else {
        df--;
    }

    dq[df] = x;
}

void dequeInsertRear() {
    int x;

    if ((df == 0 && dr == SIZE - 1) || df == dr + 1) {
        printf("Deque Overflow\n");
        return;
    }

    printf("Enter value: ");
    scanf("%d", &x);

    if (df == -1) {
        df = dr = 0;
    } else if (dr == SIZE - 1) {
        dr = 0;
    } else {
        dr++;
    }

    dq[dr] = x;
}

void dequeDeleteFront() {
    if (df == -1) {
        printf("Deque Underflow\n");
        return;
    }

    printf("Deleted: %d\n", dq[df]);

    if (df == dr)
        df = dr = -1;
    else if (df == SIZE - 1)
        df = 0;
    else
        df++;
}

void dequeDeleteRear() {
    if (df == -1) {
        printf("Deque Underflow\n");
        return;
    }

    printf("Deleted: %d\n", dq[dr]);

    if (df == dr)
        df = dr = -1;
    else if (dr == 0)
        dr = SIZE - 1;
    else
        dr--;
}

void dequeDisplay() {
    if (df == -1) {
        printf("Deque is empty\n");
        return;
    }

    int i = df;

    while (1) {
        printf("%d ", dq[i]);

        if (i == dr)
            break;

        i = (i + 1) % SIZE;
    }

    printf("\n");
}

int main() {
    int choice, sub;

    while (1) {
        printf("\nMAIN MENU\n");
        printf("1. Simple Queue\n");
        printf("2. Circular Queue\n");
        printf("3. Deque\n");
        printf("4. Exit\n");
        printf("Enter choice: ");
        scanf("%d", &choice);

        if (choice == 4)
            break;

        if (choice == 1) {
            while (1) {
                printf("\nSIMPLE QUEUE\n");
                printf("1. Enqueue\n");
                printf("2. Dequeue\n");
                printf("3. Display\n");
                printf("4. Back\n");
                printf("Enter choice: ");
                scanf("%d", &sub);

                if (sub == 1)
                    enqueue();
                else if (sub == 2)
                    dequeue();
                else if (sub == 3)
                    display();
                else if (sub == 4)
                    break;
                else
                    printf("Invalid choice\n");
            }
        } else if (choice == 2) {
            while (1) {
                printf("\nCIRCULAR QUEUE\n");
                printf("1. Enqueue\n");
                printf("2. Dequeue\n");
                printf("3. Display\n");
                printf("4. Back\n");
                printf("Enter choice: ");
                scanf("%d", &sub);

                if (sub == 1)
                    circularEnqueue();
                else if (sub == 2)
                    circularDequeue();
                else if (sub == 3)
                    circularDisplay();
                else if (sub == 4)
                    break;
                else
                    printf("Invalid choice\n");
            }
        } else if (choice == 3) {
            while (1) {
                printf("\nDEQUE\n");
                printf("1. Insert Front\n");
                printf("2. Insert Rear\n");
                printf("3. Delete Front\n");
                printf("4. Delete Rear\n");
                printf("5. Display\n");
                printf("6. Back\n");
                printf("Enter choice: ");
                scanf("%d", &sub);

                if (sub == 1)
                    dequeInsertFront();
                else if (sub == 2)
                    dequeInsertRear();
                else if (sub == 3)
                    dequeDeleteFront();
                else if (sub == 4)
                    dequeDeleteRear();
                else if (sub == 5)
                    dequeDisplay();
                else if (sub == 6)
                    break;
                else
                    printf("Invalid choice\n");
            }
        } else {
            printf("Invalid choice\n");
        }
    }

    return 0;
}
