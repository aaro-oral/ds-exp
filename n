// 1. 4:1 MUX - Logical Operators

module mux4to1(
    input D0, D1, D2, D3,
    input S1, S0,
    output Y
);

assign Y = (~S1 & ~S0 & D0) |
           (~S1 & S0 & D1) |
           (S1 & ~S0 & D2) |
           (S1 & S0 & D3);

endmodule


module tb_mux4to1;

reg D0, D1, D2, D3;
reg S1, S0;
wire Y;

mux4to1 m(D0,D1,D2,D3,S1,S0,Y);

initial begin
    D0=1; D1=0; D2=0; D3=0;

    S1=0; S0=0; #10;
    S1=0; S0=1; #10;
    S1=1; S0=0; #10;
    S1=1; S0=1; #10;

    $finish;
end

initial
    $monitor("D0=%b D1=%b D2=%b D3=%b S1=%b S0=%b Y=%b",
             D0,D1,D2,D3,S1,S0,Y);

endmodule


// 2. 4:1 MUX - Conditional Operator

module mux4to1_cond(
    input D0, D1, D2, D3,
    input S1, S0,
    output Y
);

assign Y = (S1 == 0 && S0 == 0) ? D0 :
           (S1 == 0 && S0 == 1) ? D1 :
           (S1 == 1 && S0 == 0) ? D2 : D3;

endmodule


module tb_mux4to1_cond;

reg D0, D1, D2, D3;
reg S1, S0;
wire Y;

mux4to1_cond m(D0,D1,D2,D3,S1,S0,Y);

initial begin
    D0=1; D1=0; D2=1; D3=0;

    S1=0; S0=0; #10;
    S1=0; S0=1; #10;
    S1=1; S0=0; #10;
    S1=1; S0=1; #10;

    $finish;
end

initial
    $monitor("S1=%b S0=%b Y=%b", S1,S0,Y);

endmodule


// 3. 1:4 DEMUX

module demux1to4(
    input D,
    input S1, S0,
    output Y0, Y1, Y2, Y3
);

assign Y0 = D & ~S1 & ~S0;
assign Y1 = D & ~S1 & S0;
assign Y2 = D & S1 & ~S0;
assign Y3 = D & S1 & S0;

endmodule


module tb_demux1to4;

reg D, S1, S0;
wire Y0, Y1, Y2, Y3;

demux1to4 d(D,S1,S0,Y0,Y1,Y2,Y3);

initial begin
    D=1;

    S1=0; S0=0; #10;
    S1=0; S0=1; #10;
    S1=1; S0=0; #10;
    S1=1; S0=1; #10;

    $finish;
end

initial
    $monitor("D=%b S1=%b S0=%b Y0=%b Y1=%b Y2=%b Y3=%b",
             D,S1,S0,Y0,Y1,Y2,Y3);

endmodule


// 4. 4:2 ENCODER

module encoder4to2(
    input D0, D1, D2, D3,
    output Y1, Y0
);

assign Y1 = D2 | D3;
assign Y0 = D1 | D3;

endmodule


module tb_encoder4to2;

reg D0, D1, D2, D3;
wire Y1, Y0;

encoder4to2 e(D0,D1,D2,D3,Y1,Y0);

initial begin
    D0=1; D1=0; D2=0; D3=0; #10;
    D0=0; D1=1; D2=0; D3=0; #10;
    D0=0; D1=0; D2=1; D3=0; #10;
    D0=0; D1=0; D2=0; D3=1; #10;

    $finish;
end

initial
    $monitor("D0=%b D1=%b D2=%b D3=%b Y1=%b Y0=%b",
             D0,D1,D2,D3,Y1,Y0);

endmodule


// 5. 2:4 DECODER

module decoder2to4(
    input A, B,
    output Y0, Y1, Y2, Y3
);

assign Y0 = ~A & ~B;
assign Y1 = ~A & B;
assign Y2 = A & ~B;
assign Y3 = A & B;

endmodule


module tb_decoder2to4;

reg A, B;
wire Y0, Y1, Y2, Y3;

decoder2to4 d(A,B,Y0,Y1,Y2,Y3);

initial begin
    A=0; B=0; #10;
    A=0; B=1; #10;
    A=1; B=0; #10;
    A=1; B=1; #10;

    $finish;
end

initial
    $monitor("A=%b B=%b Y0=%b Y1=%b Y2=%b Y3=%b",
             A,B,Y0,Y1,Y2,Y3);

endmodule
